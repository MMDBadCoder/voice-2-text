# ================================================================
#  دستیار صوتی جلسات — configuration
#  Values containing spaces MUST be quoted: run-local.sh sources this file
#  with `.`, and bash would otherwise treat the second word as a command.
#  Copy to .env and edit. Read by both the app and docker-compose.
# ================================================================

APP_TITLE="دستیار صوتی جلسات"
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------
#  WORKER POOL  — the main tuning knob
# ---------------------------------------------------------------
# Rule of thumb: WORKER_COUNT x WORKER_CPU_THREADS <= (cores - RESERVED_CORES).
# The app refuses to start if you exceed it, because oversubscribing makes
# transcription SLOWER, not faster.
#
#   10 cores -> 2 x 4  (recommended: best total throughput)
#              3 x 2   (more meetings in parallel, each one slower)
#              1 x 8   (worst: Whisper's CPU scaling flattens past ~6 threads)
WORKER_COUNT=1
WORKER_CPU_THREADS=2
RESERVED_CORES=1
WORKER_JOB_TIMEOUT=14400

# Hard cgroup ceilings, applied by docker-compose (per worker container).
WORKER_CPU_LIMIT=4.0
WORKER_MEM_LIMIT=6g
API_CPU_LIMIT=1.5
API_MEM_LIMIT=2g

# ---------------------------------------------------------------
#  ASR
# ---------------------------------------------------------------
# faster_whisper = real transcription. stub = fake output, no model needed,
# for verifying the queue/UI/exports before the model has been copied over.
ASR_BACKEND=faster_whisper

MODELS_DIR=./models
MODEL_FAST=./models/whisper-fa-turbo-int8
MODEL_ACCURATE=./models/whisper-fa-large-v3-int8

# Default downloader provides the accurate model. Enable fast only after conversion.
ENABLED_TIERS=accurate
DEFAULT_TIER=accurate

COMPUTE_TYPE=int8
LANGUAGE=fa
BEAM_SIZE=5
INITIAL_PROMPT="این یک جلسهٔ کاری است. متن با نقطه، ویرگول و علائم نگارشی فارسی نوشته می‌شود."

# ---------------------------------------------------------------
#  VAD — strips silence before decoding. Meetings are 30-50% silence,
#  so this is close to free speedup. Leave on.
# ---------------------------------------------------------------
VAD_ENABLED=true
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=200

# ---------------------------------------------------------------
#  DIARIZATION (تفکیک گوینده) — optional, adds ~47 MB of models
#  Requires: pip install sherpa-onnx
# ---------------------------------------------------------------
DIARIZATION_ENABLED=false
DIARIZATION_SEGMENTATION_MODEL=./models/diarization/segmentation.onnx
DIARIZATION_EMBEDDING_MODEL=./models/diarization/embedding.onnx
DIARIZATION_NUM_SPEAKERS=0
DIARIZATION_CLUSTER_THRESHOLD=0.5

# ---------------------------------------------------------------
#  STORAGE & RETENTION
#  Uploads, not the app, are what fills the disk: 1h of mp3 ~ 58 MB.
# ---------------------------------------------------------------
DATA_DIR=./data
DB_URL=sqlite:///./data/jobs.db
MAX_UPLOAD_MB=500
ALLOWED_EXTENSIONS=mp3,wav,m4a,ogg,opus,flac,mp4,mkv,webm,aac,wma
DELETE_AUDIO_AFTER_TRANSCRIBE=false
RETENTION_DAYS=0

# ---------------------------------------------------------------
#  QUEUE
# ---------------------------------------------------------------
# Local Redis address. Docker Compose overrides this with its redis service.
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=transcription
